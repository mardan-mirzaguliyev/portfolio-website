---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noIndex?: boolean;
  type?: 'website' | 'article';
  pubDate?: Date;
  /** 'landing' renders a bare, always-dark shell — the page supplies its own nav via slot="header" */
  variant?: 'default' | 'landing';
}

const {
  title,
  description = 'Mardan Mirzaguliyev — Data Analyst specializing in data visualisation, text mining, and open-source tooling.',
  image = '/og-default.png',
  noIndex = false,
  type = 'website',
  pubDate,
  variant = 'default',
} = Astro.props;

const isLanding = variant === 'landing';

const siteUrl   = Astro.site ?? new URL('https://mmardan.com');
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImage   = new URL(image, siteUrl).href;
const pageTitle = title === 'Home' ? 'Mardan Mirzaguliyev — Data Analyst' : `${title} · Mardan`;
---

<!doctype html>
<html lang="en" class:list={[isLanding && 'landing']}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- BLOCKING theme script — runs before first paint to prevent flash.
         Day (#eff0e4) is the default; night only when the visitor has chosen it. -->
    <script is:inline>
      (function () {
        var stored = null;
        try { stored = localStorage.getItem('theme'); } catch (e) {}
        document.documentElement.classList.toggle('dark', stored === 'dark');
      })();
    </script>
    {isLanding && (
      <!-- Flags JS support so scroll-reveal styles only hide content when they can un-hide it -->
      <script is:inline>document.documentElement.classList.add('js');</script>
    )}

    <!-- Primary meta -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noIndex && <meta name="robots" content="noindex,nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type"        content={type} />
    <meta property="og:url"         content={canonical} />
    <meta property="og:title"       content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:site_name"   content="Mardan Mirzaguliyev" />
    {type === 'article' && pubDate && (
      <meta property="article:published_time" content={pubDate.toISOString()} />
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />

    <!-- Favicons -->
    <link rel="icon"             type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon"             type="image/png"     href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon"                      href="/apple-touch-icon.png" />

    <meta name="generator" content={Astro.generator} />
  </head>

  <body class:list={[
    'min-h-screen',
    isLanding ? 'bg-paper text-ink' : 'flex flex-col text-zinc-900 dark:text-zinc-100',
  ]}>

    {isLanding ? <slot name="header" /> : <Navbar />}

    <main id="main-content" class:list={[!isLanding && 'flex-1']}>
      <slot />
    </main>

    {!isLanding && <Footer />}
  </body>
</html>
