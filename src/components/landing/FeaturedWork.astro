---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
---

<section id="work" class="relative scroll-mt-20 bg-paper px-6 pb-40 sm:px-10 sm:pb-56 lg:px-16">

  <div class="mb-16 flex items-end justify-between gap-6 border-b border-ink/10 pb-8 sm:mb-24">
    <div>
      <p class="eyebrow reveal mb-6">(03) — Featured work</p>
      <h2 class="reveal font-display text-[clamp(2.75rem,8vw,8rem)] font-semibold leading-[0.88] tracking-[-0.055em]">
        Selected work<span class="text-brand">.</span>
      </h2>
    </div>
    <a href="/projects" class="text-link reveal mb-2 hidden shrink-0 sm:inline-flex">All projects</a>
  </div>

  <div class="grid gap-x-8 gap-y-20 md:grid-cols-3">
    {projects.map((project, i) => (
      <a
        href={`/projects/${project.slug}`}
        class:list={['work-card reveal', i === 1 && 'md:mt-28']}
        style={`--reveal-delay:${i * 120}ms`}
      >
        <div class="work-card__media reveal-clip">
          <div class={`work-card__art work-art--${i % 3}`}>
            {project.data.logo && (
              <Image src={project.data.logo} alt="" width={720} class="work-card__logo" />
            )}
          </div>
        </div>

        <div class="mt-6 flex items-start justify-between gap-6">
          <div>
            <h3 class="work-card__title font-display text-2xl font-medium tracking-[-0.025em]">{project.data.title}</h3>
            <p class="mt-2 text-sm text-ink/45">{project.data.tags.slice(0, 3).join(' · ')}</p>
          </div>
          <span class="pt-2 font-mono text-xs text-ink/35">{String(i + 1).padStart(2, '0')}</span>
        </div>
      </a>
    ))}
  </div>

  <div class="mt-16 text-center sm:hidden">
    <a href="/projects" class="text-link">All projects</a>
  </div>
</section>
