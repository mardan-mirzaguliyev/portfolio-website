---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Drop a portrait at src/assets/images/portrait.(jpg|png|webp) and it's picked up automatically
const portraitModules = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/images/portrait.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const portrait = Object.values(portraitModules)[0]?.default;

const links = [
  { label: 'X',          handle: '@yourusername',           href: 'https://x.com/yourusername' },
  { label: 'LinkedIn',   handle: 'in/yourusername',         href: 'https://linkedin.com/in/yourusername' },
  { label: 'Newsletter', handle: 'The Narratives in Graphs', href: 'https://thenarrativesingraphs.substack.com' },
];
---

<section id="about" class="relative scroll-mt-20 bg-paper px-6 pb-40 sm:px-10 sm:pb-56 lg:px-16">
  <div class="grid items-start gap-16 lg:grid-cols-12 lg:gap-10">

    <!-- ── Left: portrait ─────────────────────────────── -->
    <figure class="lg:col-span-5">
      <div class="portrait reveal-clip relative aspect-[4/5] overflow-hidden bg-ink/[0.06]">
        {portrait ? (
          <Image
            src={portrait}
            alt="Portrait of Mardan Mirzaguliyev"
            widths={[480, 800, 1200]}
            sizes="(min-width: 1024px) 40vw, 100vw"
            class="portrait__img h-full w-full object-cover"
          />
        ) : (
          <div class="portrait__placeholder" aria-hidden="true">
            <span class="font-display">MM</span>
          </div>
        )}
      </div>
      <figcaption class="eyebrow reveal mt-5 flex justify-between">
        <span>Mardan Mirzaguliyev</span>
        <span>Azerbaijan — {new Date().getFullYear()}</span>
      </figcaption>
    </figure>

    <!-- ── Right: bio + links ─────────────────────────── -->
    <div class="lg:col-span-6 lg:col-start-7 lg:pt-24">
      <p class="eyebrow reveal mb-10">(02) — About</p>

      <h2 class="reveal font-display text-[clamp(2.25rem,4.5vw,4.25rem)] font-semibold leading-[1] tracking-[-0.045em]">
        Analyst by training.<br />
        <span class="text-ink/35">Storyteller by instinct.</span>
      </h2>

      <div class="reveal mt-10 max-w-xl space-y-6 text-lg leading-relaxed text-ink/60" style="--reveal-delay:100ms">
        <p>
          I'm a Data Analyst working across data visualisation, text mining and open-source tooling.
          Most of my work happens in R — cleaning messy sources, modelling what's inside them, and
          designing plots that hold up to scrutiny.
        </p>
        <p>
          On the side I write <em class="text-ink/85 not-italic">The Narratives in Graphs</em>, a
          publication that reads song lyrics, film scripts and literature as data — tracing the
          emotional arcs hidden between the lines.
        </p>
      </div>

      <ul class="reveal mt-16 border-t border-ink/10" role="list" style="--reveal-delay:200ms">
        {links.map(({ label, handle, href }) => (
          <li>
            <a href={href} target="_blank" rel="noopener noreferrer" class="link-row">
              <span class="link-row__label font-display">{label}</span>
              <span class="link-row__handle">{handle}</span>
              <svg class="link-row__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M7 17 17 7M8 7h9v9" />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
