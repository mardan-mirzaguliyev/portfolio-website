---
const navLinks = [
  { label: 'Work',    href: '#work'    },
  { label: 'About',   href: '#about'   },
  { label: 'Writing', href: '/blog'    },
  { label: 'Contact', href: '#contact' },
];
---

<header id="landing-nav" class="landing-nav fixed inset-x-0 top-0 z-50" data-scrolled="false" data-hidden="false" data-open="false">
  <nav class="landing-nav__bar flex items-center justify-between px-6 sm:px-10 lg:px-16" aria-label="Main navigation">

    <a href="#top" class="font-display text-[15px] font-semibold tracking-tight text-white" aria-label="Back to top">
      mmardan<span class="text-brand">.</span>
    </a>

    <ul class="hidden md:flex items-center gap-10" role="list">
      {navLinks.map(({ label, href }) => (
        <li>
          <a href={href} class="roll-link text-[13px] font-medium tracking-wide text-white/70 hover:text-white">
            <span class="roll-link__inner" data-text={label}>{label}</span>
          </a>
        </li>
      ))}
    </ul>

    <a href="#contact" class="nav-pill hidden md:inline-flex" data-magnetic>
      <span class="nav-pill__dot" aria-hidden="true"></span>
      Let's talk
    </a>

    <button
      id="landing-menu-btn"
      class="md:hidden relative h-10 w-10 -mr-2 flex items-center justify-center text-white"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="landing-menu"
    >
      <span class="menu-icon" aria-hidden="true"><span></span><span></span></span>
    </button>
  </nav>

  <!-- Mobile full-screen menu -->
  <div id="landing-menu" class="landing-menu md:hidden" aria-label="Mobile navigation">
    <ul class="flex flex-col gap-2 px-6 sm:px-10" role="list">
      {navLinks.map(({ label, href }, i) => (
        <li class="overflow-hidden">
          <a href={href} class="landing-menu__link font-display" style={`--i:${i}`}>{label}</a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const nav  = document.getElementById('landing-nav')!;
  const btn  = document.getElementById('landing-menu-btn')!;
  const menu = document.getElementById('landing-menu')!;

  // Solid on scroll; tucks away while scrolling down, returns on scroll up
  let lastY = window.scrollY;
  let ticking = false;

  function update() {
    ticking = false;
    const y = window.scrollY;
    nav.dataset.scrolled = String(y > 24);
    if (nav.dataset.open !== 'true') {
      nav.dataset.hidden = String(y > lastY && y > window.innerHeight * 0.8);
    }
    lastY = y;
  }

  window.addEventListener('scroll', () => {
    if (!ticking) { ticking = true; requestAnimationFrame(update); }
  }, { passive: true });
  update();

  function setOpen(open: boolean) {
    nav.dataset.open = String(open);
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    document.documentElement.style.overflow = open ? 'hidden' : '';
  }

  btn.addEventListener('click', () => setOpen(nav.dataset.open !== 'true'));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  window.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
</script>
