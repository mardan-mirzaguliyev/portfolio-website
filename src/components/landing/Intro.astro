---
const text =
  'I believe every dataset hides a story. My work lives where analysis meets design — mining text, shaping numbers, and building visuals that make complex things feel obvious.';
const accentWords = new Set(['story.', 'obvious.']);
const words = text.split(' ');
---

<section id="intro" class="relative bg-black px-6 py-40 sm:px-10 sm:py-56 lg:px-16">
  <p class="eyebrow reveal mb-14 text-center">(01) — Intro</p>

  <!-- Words light up one by one as the paragraph scrolls through the viewport -->
  <p
    class="mx-auto max-w-6xl text-center font-display font-medium text-white
           text-[clamp(1.85rem,4.6vw,4.5rem)] leading-[1.08] tracking-[-0.035em]"
    data-intro-words
  >
    {words.map((word) => (
      <>
        <span class:list={['intro-word', accentWords.has(word) && 'text-brand']}>{word}</span>{' '}
      </>
    ))}
  </p>
</section>
