---
const navLinks = [
  { label: 'Home',     href: '/'         },
  { label: 'Projects', href: '/projects' },
  { label: 'Blog',     href: '/blog'     },
  { label: 'Contact',  href: '/contact'  },
];

// Section pages stay active on their detail pages (/blog/my-post → Blog)
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
---

<header id="site-nav" class="site-nav fixed inset-x-0 top-0 z-[60]" data-scrolled="false" data-hidden="false" data-open="false">
  <nav class="site-nav__bar flex items-center justify-between px-6 sm:px-10 lg:px-16" aria-label="Main navigation">

    <a href="/" class="font-display text-[15px] font-semibold tracking-tight text-ink" aria-label="mmardan — Home">
      mmardan<span class="text-brand">.</span>
    </a>

    <ul class="hidden md:flex items-center gap-10" role="list">
      {navLinks.map(({ label, href }) => (
        <li class="relative">
          <a
            href={href}
            class="nav-link roll-link text-[13px] font-medium tracking-wide text-ink/60 hover:text-ink"
            aria-current={isActive(href) ? 'page' : undefined}
          >
            <span class="roll-link__inner" data-text={label}>{label}</span>
          </a>
          <!-- Outside the link: .roll-link clips its overflow for the hover roll -->
          {isActive(href) && <span class="nav-dot" aria-hidden="true"></span>}
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-3 sm:gap-4">
      <button type="button" class="theme-switch" role="switch" aria-checked="false" aria-label="Night mode" data-theme-switch>
        <span class="theme-switch__knob" aria-hidden="true">
          <svg class="theme-switch__icon theme-switch__icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
          </svg>
          <svg class="theme-switch__icon theme-switch__icon--moon" viewBox="0 0 24 24" fill="currentColor">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
          </svg>
        </span>
      </button>

      <button
        id="site-menu-btn"
        class="md:hidden relative h-10 w-10 -mr-2 flex items-center justify-center text-ink"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="site-menu"
        type="button"
      >
        <span class="menu-icon" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </nav>
</header>

<!-- Mobile drawer. Kept outside the header: once scrolled, the header's backdrop-filter makes it the
     containing block for fixed children, which collapsed the menu to the bar's height. -->
<nav id="site-menu" class="site-menu md:hidden" data-open="false" aria-label="Mobile navigation" inert>
  <ul class="site-menu__list px-6 sm:px-10" role="list">
    {navLinks.map(({ label, href }, i) => (
      <li class="overflow-hidden border-b border-ink/10">
        <a
          href={href}
          class="site-menu__link font-display"
          style={`--i:${i}`}
          aria-current={isActive(href) ? 'page' : undefined}
        >{label}</a>
      </li>
    ))}
  </ul>
</nav>

<script>
  const nav  = document.getElementById('site-nav')!;
  const btn  = document.getElementById('site-menu-btn')!;
  const menu = document.getElementById('site-menu')!;

  // Solid on scroll; tucks away while scrolling down, returns on scroll up
  let lastY = window.scrollY;
  let ticking = false;

  function update() {
    ticking = false;
    const y = window.scrollY;
    nav.dataset.scrolled = String(y > 24);
    if (nav.dataset.open !== 'true') {
      nav.dataset.hidden = String(y > lastY && y > window.innerHeight * 0.8);
    }
    lastY = y;
  }

  window.addEventListener('scroll', () => {
    if (!ticking) { ticking = true; requestAnimationFrame(update); }
  }, { passive: true });
  update();

  const isOpen = () => nav.dataset.open === 'true';

  function setOpen(open: boolean, { restoreFocus = false } = {}) {
    if (open === isOpen()) return;
    nav.dataset.open = String(open);
    menu.dataset.open = String(open);
    menu.inert = !open;
    if (open) nav.dataset.hidden = 'false';
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    document.documentElement.style.overflow = open ? 'hidden' : '';
    if (!open && restoreFocus) btn.focus();
  }

  btn.addEventListener('click', () => setOpen(!isOpen()));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  window.addEventListener('keydown', (e) => { if (e.key === 'Escape' && isOpen()) setOpen(false, { restoreFocus: true }); });
  // Growing past the md breakpoint hides the drawer, so don't leave the page scroll-locked behind it
  window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => { if (e.matches) setOpen(false); });

  // Night mode — persisted under the 'theme' key, read before first paint in BaseLayout
  const root     = document.documentElement;
  const switches = document.querySelectorAll<HTMLElement>('[data-theme-switch]');

  const syncSwitches = () => {
    const dark = root.classList.contains('dark');
    switches.forEach((s) => s.setAttribute('aria-checked', String(dark)));
  };

  function setTheme(dark: boolean, origin: HTMLElement) {
    const apply = () => {
      root.classList.toggle('dark', dark);
      try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
      syncSwitches();
    };

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!('startViewTransition' in document) || reduceMotion) return apply();

    // New theme spreads out in a circle from the switch. The class opts this transition out of the
    // page cross-fade defined in site.css.
    const r = origin.getBoundingClientRect();
    const x = r.left + r.width / 2;
    const y = r.top + r.height / 2;
    const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));

    root.classList.add('theme-transition');
    const transition = document.startViewTransition(apply);
    transition.ready.then(() => {
      root.animate(
        { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
        { duration: 1000, easing: 'cubic-bezier(0.25, 1, 0.5, 1)', pseudoElement: '::view-transition-new(root)' },
      );
    });
    transition.finished.finally(() => root.classList.remove('theme-transition'));
  }

  switches.forEach((s) => s.addEventListener('click', () => setTheme(!root.classList.contains('dark'), s)));
  syncSwitches();
</script>
