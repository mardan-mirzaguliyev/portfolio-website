---
// Opening block for inner pages: hero-style eyebrow, display title with the brand dot, optional lead.
interface Props {
  eyebrow: string;
  /** Rendered as the page's <h1>; the blue dot is appended */
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<header class="mb-16 grid gap-8 border-b border-ink/10 pb-10 sm:mb-20 lg:grid-cols-12 lg:items-end">
  <div class="lg:col-span-8">
    <p class="eyebrow reveal mb-6 flex items-center gap-4">
      <span class="h-px w-10 bg-ink/40" aria-hidden="true"></span>
      {eyebrow}
    </p>
    <h1 class="reveal font-display text-[clamp(3rem,9vw,8.5rem)] font-semibold leading-[0.88] tracking-[-0.055em]">
      {title}<span class="text-brand">.</span>
    </h1>
  </div>
  {(lead || Astro.slots.has('default')) && (
    <div class="reveal max-w-sm text-base leading-relaxed text-ink/65 lg:col-span-4 lg:justify-self-end lg:pb-2" style="--reveal-delay:100ms">
      {lead && <p>{lead}</p>}
      <slot />
    </div>
  )}
</header>
