---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { achievementsData, type AchievementCategory } from '../../data/achievements';

// In-progress first, then newest first
const items = [...achievementsData]
  .sort((a, b) => {
    if ((a.status === 'in-progress') !== (b.status === 'in-progress')) return a.status === 'in-progress' ? -1 : 1;
    return b.date.localeCompare(a.date);
  })
  .map((item) => {
    // Only render an image whose file is actually in public/ — otherwise fall back to the placeholder frame
    const hasImage = !!item.imageUrl && existsSync(join(process.cwd(), 'public', item.imageUrl));
    if (item.imageUrl && !hasImage) {
      console.warn(`[certifications] "${item.id}": image not found at public${item.imageUrl} — showing placeholder`);
    }
    return { ...item, hasImage };
  });

const CATEGORY_ICONS: Record<AchievementCategory, string> = {
  'Data Science':               `<path d="M4 20V10M10 20V4M16 20v-7M22 20H2" />`,
  'Machine Learning':           `<circle cx="5" cy="6" r="2"/><circle cx="5" cy="18" r="2"/><circle cx="19" cy="12" r="2"/><path d="M7 6.8 17 11.2M7 17.2l10-4.4" />`,
  'Web Development':            `<path d="m8 7-5 5 5 5M16 7l5 5-5 5M13.5 4l-3 16" />`,
  'Cloud Engineering':          `<path d="M17.5 19H8a5 5 0 1 1 1.1-9.88A6 6 0 0 1 20.5 11a4 4 0 0 1-3 8z" />`,
  'Teaching & Linguistics':     `<path d="M2 5h7a3 3 0 0 1 3 3v12a2 2 0 0 0-2-2H2zM22 5h-7a3 3 0 0 0-3 3v12a2 2 0 0 1 2-2h8z" />`,
  'Professional Certification': `<circle cx="12" cy="9" r="6"/><path d="m8.5 14-1.5 7 5-3 5 3-1.5-7" />`,
};

// 'YYYY' → '2026', 'YYYY-MM' / 'YYYY-MM-DD' → 'Apr 2026' (UTC so the month never shifts with the visitor's timezone)
const formatDate = (date: string) => {
  if (/^\d{4}$/.test(date)) return date;
  return new Intl.DateTimeFormat('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' })
    .format(new Date(`${date.length === 7 ? `${date}-01` : date}T00:00:00Z`));
};
---

<section id="certifications" class="relative scroll-mt-20 bg-paper px-6 pb-40 sm:px-10 sm:pb-56 lg:px-16" aria-labelledby="certifications-title">

  <div class="mb-16 grid gap-8 border-b border-ink/10 pb-8 sm:mb-20 lg:grid-cols-12 lg:items-end">
    <div class="lg:col-span-8">
      <p class="eyebrow reveal mb-6 flex items-center gap-4">
        <span class="h-px w-10 bg-ink/40" aria-hidden="true"></span>
        Certifications &amp; Credentials
      </p>
      <h2 id="certifications-title" class="reveal font-display text-[clamp(2.5rem,6.5vw,6.5rem)] font-semibold leading-[0.9] tracking-[-0.055em]">
        Continuous Learning<br class="hidden sm:block" /> &amp; Milestones<span class="text-brand">.</span>
      </h2>
    </div>
    <p class="reveal max-w-sm text-base leading-relaxed text-ink/65 lg:col-span-4 lg:justify-self-end lg:pb-2">
      Continuous learning, on the record — the courses, credentials and milestones behind my work.
    </p>
  </div>

  <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" role="list">
    {items.map((item) => {
      const inProgress = item.status === 'in-progress';
      const icon = CATEGORY_ICONS[item.category];
      return (
        <li class="reveal flex">
          <article class:list={['cert-card', item.featured && 'cert-card--featured']}>

            {item.hasImage ? (
              <button
                type="button"
                class="cert-thumb"
                data-cert-open
                data-src={item.imageUrl}
                data-title={item.title}
                aria-label={`View original certificate image: ${item.title}`}
                aria-haspopup="dialog"
              >
                <img src={item.imageUrl} alt="" loading="lazy" decoding="async" class="cert-thumb__img" />
                <span class="cert-thumb__hint" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" /></svg>
                  View original image
                </span>
              </button>
            ) : (
              <div class="cert-thumb cert-thumb--empty" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" set:html={icon} />
              </div>
            )}

            <header class="mt-8 flex items-center justify-between gap-4">
              <span class="cert-badge">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icon} />
                {item.category}
              </span>

              {inProgress ? (
                <span class="cert-status">
                  <span class="cert-status__dot" aria-hidden="true"></span>
                  In progress
                </span>
              ) : (
                <time class="font-mono text-xs text-ink/60" datetime={item.date}>{formatDate(item.date)}</time>
              )}
            </header>

            <div class="mt-7 flex-1">
              {item.featured && <p class="cert-featured">Featured</p>}
              <h3 class="font-display text-[1.6rem] font-medium leading-[1.12] tracking-[-0.03em]">{item.title}</h3>
              <p class="mt-3 text-sm text-ink/65">{item.issuer}</p>
            </div>

            <ul class="mt-7 flex flex-wrap gap-2" role="list" aria-label="Skills covered">
              {item.skills.map((skill) => <li class="chip">{skill}</li>)}
            </ul>

            {item.credentialId && (
              <p class="mt-7 font-mono text-[11px] text-ink/50">
                Certificate No. <span class="select-all text-ink/75">{item.credentialId}</span>
              </p>
            )}

            {item.credentialUrl && (
              <a
                href={item.credentialUrl}
                target="_blank"
                rel="noopener noreferrer"
                class:list={['cert-verify', inProgress && 'cert-verify--ghost']}
                aria-label={`${inProgress ? 'View course' : 'Verify credential'}: ${item.title} (opens in a new tab)`}
              >
                {inProgress ? 'View course' : 'Verify Credential'}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
              </a>
            )}
          </article>
        </li>
      );
    })}
  </ul>

  <!-- Shared lightbox — filled from the clicked card -->
  <dialog id="cert-lightbox" class="cert-lightbox" aria-labelledby="cert-lightbox-title">
    <div class="cert-lightbox__scrim" data-cert-close></div>
    <div class="cert-lightbox__panel">
      <div class="cert-lightbox__bar">
        <p id="cert-lightbox-title" class="cert-lightbox__title"></p>
        <div class="flex items-center gap-2">
          <a class="cert-lightbox__file" target="_blank" rel="noopener noreferrer">
            Open file
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
          </a>
          <button type="button" class="cert-lightbox__close" data-cert-close aria-label="Close certificate preview">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
          </button>
        </div>
      </div>
      <div class="cert-lightbox__stage" data-cert-close>
        <span class="cert-lightbox__spinner" aria-hidden="true"></span>
        <img class="cert-lightbox__img" alt="" />
      </div>
    </div>
  </dialog>
</section>

<script>
  const dialog = document.getElementById('cert-lightbox') as HTMLDialogElement | null;

  if (dialog) {
    const img      = dialog.querySelector<HTMLImageElement>('.cert-lightbox__img')!;
    const title    = dialog.querySelector<HTMLElement>('.cert-lightbox__title')!;
    const fileLink = dialog.querySelector<HTMLAnchorElement>('.cert-lightbox__file')!;
    const closeBtn = dialog.querySelector<HTMLButtonElement>('.cert-lightbox__close')!;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const CLOSE_MS = 450; // matches the panel transition in site.css
    let closeTimer = 0;

    img.addEventListener('load', () => { dialog.dataset.loaded = 'true'; });

    function open(trigger: HTMLElement) {
      window.clearTimeout(closeTimer);
      const src = trigger.dataset.src!;
      dialog!.dataset.loaded = 'false';
      if (img.getAttribute('src') !== src) img.src = src;
      else if (img.complete) dialog!.dataset.loaded = 'true';
      img.alt = `Certificate: ${trigger.dataset.title}`;
      title.textContent = trigger.dataset.title ?? '';
      fileLink.href = src;

      dialog!.showModal();
      closeBtn.focus();
      document.documentElement.style.overflow = 'hidden';
      requestAnimationFrame(() => dialog!.classList.add('is-open'));
    }

    function close() {
      if (!dialog!.open || !dialog!.classList.contains('is-open')) return;
      dialog!.classList.remove('is-open');
      // Let the exit transition play before removing the dialog from the top layer
      closeTimer = window.setTimeout(() => {
        dialog!.close();
        document.documentElement.style.overflow = '';
      }, reduceMotion ? 0 : CLOSE_MS);
    }

    document.querySelectorAll<HTMLElement>('[data-cert-open]').forEach((btn) => {
      btn.addEventListener('click', () => open(btn));
    });

    // Scrim, empty stage area and the close button dismiss; clicks on the image itself don't
    dialog.addEventListener('click', (e) => {
      const target = e.target as Element;
      if (target.closest('[data-cert-close]') && !target.closest('.cert-lightbox__img')) close();
    });
    // Esc: run the animated close instead of the instant native one
    dialog.addEventListener('cancel', (e) => { e.preventDefault(); close(); });
  }
</script>
