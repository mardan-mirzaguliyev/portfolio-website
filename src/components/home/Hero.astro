---
// One title, split into lines for the staggered entrance. The full stop is drawn as the brand dot.
const headline = ['Mardan Mirzaguliyev —', 'TESOL Certified English Teacher', '& Data Analyst'];
---

<section class="hero relative isolate h-[100svh] min-h-[600px] w-full overflow-hidden bg-paper" data-hero>

  <!-- Plain background layer — moves at a slower rate than the page (parallax) -->
  <div class="hero-bg" data-parallax-bg aria-hidden="true"></div>
  <div class="hero-grain" aria-hidden="true"></div>
  <div class="hero-vignette" aria-hidden="true"></div>

  <!-- Each element enters on its own --d delay for a staggered load sequence -->
  <div class="hero-content relative z-10 flex h-full flex-col justify-end px-6 pb-8 sm:px-10 sm:pb-12 lg:px-16" data-parallax-content>

    <h1 class="max-w-[16ch] font-display font-semibold text-ink leading-[0.92] tracking-[-0.05em] text-[clamp(2.6rem,6.4vw,7.25rem)] sm:max-w-none">
      {headline.map((line, i) => (
        <span class="hero-enter block pb-[0.06em] -mb-[0.06em]" style={`--d:${200 + i * 120}ms`}>
          {line}{i === headline.length - 1 && <span class="text-brand">.</span>}
        </span>
      ))}
    </h1>

    <div class="relative mt-10 sm:mt-14 flex items-end justify-between gap-8 pt-6">
      <span class="hero-rule" style="--d:560ms" aria-hidden="true"></span>
      <p class="hero-enter max-w-md text-base sm:text-lg leading-relaxed text-ink/70" style="--d:660ms">
        I turn text, numbers and noise into clear visual narratives — where data science meets design.
      </p>
      <a href="#intro" class="hero-enter scroll-cue shrink-0" style="--d:800ms" aria-label="Scroll to content">
        <span class="scroll-cue__label">Scroll</span>
        <span class="scroll-cue__track" aria-hidden="true"><span class="scroll-cue__dot"></span></span>
      </a>
    </div>
  </div>
</section>
