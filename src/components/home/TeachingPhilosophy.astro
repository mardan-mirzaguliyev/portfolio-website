---
import PdfViewer from '../PdfViewer.astro';
---

<section id="teaching-philosophy" class="relative scroll-mt-20 bg-paper px-6 pb-40 sm:px-10 sm:pb-56 lg:px-16" aria-labelledby="teaching-philosophy-title">

  <div class="mb-16 grid gap-8 border-b border-ink/10 pb-8 sm:mb-20 lg:grid-cols-12 lg:items-end">
    <div class="lg:col-span-8">
      <p class="eyebrow reveal mb-6 flex items-center gap-4">
        <span class="h-px w-10 bg-ink/40" aria-hidden="true"></span>
        Teaching Philosophy
      </p>
      <h2 id="teaching-philosophy-title" class="reveal font-display text-[clamp(2.5rem,6.5vw,6.5rem)] font-semibold leading-[0.9] tracking-[-0.055em]">
        How I teach<span class="text-brand">.</span>
      </h2>
    </div>
    <p class="reveal max-w-sm text-base leading-relaxed text-ink/65 lg:col-span-4 lg:justify-self-end lg:pb-2">
      My approach to teaching English to speakers of other languages, in my own words.
    </p>
  </div>

  <PdfViewer src="/assets/docs/teaching-philosophy.pdf" title="Teaching Philosophy (PDF)" />
</section>
