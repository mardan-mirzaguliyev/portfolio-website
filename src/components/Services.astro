---
// Homepage services: section header, one card per offering, and a closing CTA to the contact page.
import { services } from '../data/servicesData.js';
---

<section id="services" class="relative scroll-mt-20 bg-paper px-6 pt-32 sm:px-10 sm:pt-44 lg:px-16" aria-labelledby="services-title">

  <div class="mb-16 border-b border-ink/10 pb-8 sm:mb-20">
    <p class="eyebrow reveal mb-6 flex items-center gap-4">
      <span class="h-px w-10 bg-ink/40" aria-hidden="true"></span>
      What I Offer
    </p>
    <h2 id="services-title" class="reveal font-display text-[clamp(2.5rem,6.5vw,6.5rem)] font-semibold leading-[0.9] tracking-[-0.055em]">
      Services &amp; Specializations<span class="text-brand">.</span>
    </h2>
  </div>

  <ul class="grid gap-6 lg:grid-cols-3" role="list">
    {services.map(({ title, description, icon }, i) => (
      <li class="reveal flex">
        <article class="service-card">
          <div class="flex items-start justify-between gap-6">
            <span class="service-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={icon} />
            </span>
            <span class="font-mono text-xs text-ink/40" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          </div>
          <h3 class="mt-14 font-display text-[1.75rem] font-medium leading-[1.1] tracking-[-0.03em]">{title}</h3>
          <p class="mt-4 text-[15px] leading-relaxed text-ink/65">{description}</p>
        </article>
      </li>
    ))}
  </ul>

  <div class="services-cta reveal mt-16 sm:mt-20">
    <p class="mx-auto max-w-2xl font-display text-[clamp(1.6rem,3.4vw,2.75rem)] font-medium leading-[1.1] tracking-[-0.035em]">
      Looking to elevate your English proficiency or prepare for an exam?
    </p>
    <p class="mx-auto mt-4 max-w-md text-[15px] leading-relaxed text-ink/65">
      Tell me about your goals and we'll plan lessons around them.
    </p>
    <a href="/contact" class="services-cta__btn mt-10">
      Book a Lesson
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </a>
  </div>
</section>
