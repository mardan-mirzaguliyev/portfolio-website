---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  tags: string[];
  /** Internal case-study page — the card's main link */
  href: string;
  liveUrl?: string;
  repositoryUrl?: string;
  featured?: boolean;
  logo?: ImageMetadata;
  /** Position in the grid — picks one of three abstract artworks for cards without a logo */
  index?: number;
}

const { title, description, tags, href, liveUrl, repositoryUrl, featured, logo, index = 0 } = Astro.props;
---

<article class="work-card group">
  <div class="work-card__media reveal-clip">
    <div class={`work-card__art work-art--${index % 3}`}>
      {logo && (
        <Image
          src={logo}
          alt=""
          widths={[480, 720, 1080]}
          sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
          class="work-card__logo"
        />
      )}
    </div>
    {featured && <span class="work-card__flag">Featured</span>}
  </div>

  <div class="mt-6 flex items-start justify-between gap-6">
    <h2 class="font-display text-2xl font-medium tracking-[-0.025em]">
      <!-- Stretched link: its ::after covers the whole card -->
      <a href={href} class="work-card__link work-card__title">{title}</a>
    </h2>
    <span class="pt-2 font-mono text-xs text-ink/35">{String(index + 1).padStart(2, '0')}</span>
  </div>

  <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-ink/60">{description}</p>

  <ul class="mt-5 flex flex-wrap gap-2" role="list" aria-label="Technologies">
    {tags.map((tag) => <li class="chip">{tag}</li>)}
  </ul>

  {(liveUrl || repositoryUrl) && (
    <div class="relative z-10 mt-6 flex items-center gap-6 border-t border-ink/10 pt-5">
      {liveUrl && (
        <a href={liveUrl} target="_blank" rel="noopener noreferrer" class="text-link" aria-label={`${title} live site (opens in a new tab)`}>
          Live site ↗
        </a>
      )}
      {repositoryUrl && (
        <a href={repositoryUrl} target="_blank" rel="noopener noreferrer" class="text-link" aria-label={`${title} source code (opens in a new tab)`}>
          Source ↗
        </a>
      )}
    </div>
  )}
</article>
