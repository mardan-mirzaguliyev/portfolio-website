---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { NEWSLETTER_URL } from '../../data/social';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<BaseLayout
  title="Blog"
  description="Articles, tutorials and notes on data analysis, text mining and building for the web."
>
  <section class="px-6 pb-32 pt-36 sm:px-10 sm:pb-40 sm:pt-44 lg:px-16">
    <PageHeader
      eyebrow="Blog — Writing"
      title="Notes & articles"
      lead="Tutorials and notes from my work. Long-form text analyses live in my Substack, Visage Quant."
    />

    {posts.length === 0 ? (
      <p class="text-ink/55">No posts published yet. Check back soon.</p>
    ) : (
      <ol class="border-t border-ink/10" role="list">
        {posts.map((post, i) => (
          <li class="reveal" style={`--reveal-delay:${Math.min(i, 4) * 80}ms`}>
            <a href={`/blog/${post.slug}`} class="post-row group">
              <time datetime={post.data.pubDate.toISOString()} class="font-mono text-xs text-ink/45">
                {formatDate(post.data.pubDate)}
              </time>
              <div>
                <h2 class="post-row__title font-display text-[clamp(1.5rem,2.8vw,2.4rem)] font-medium leading-[1.1] tracking-[-0.035em]">
                  {post.data.title}
                </h2>
                <p class="mt-3 max-w-2xl text-sm leading-relaxed text-ink/60">{post.data.description}</p>
                <ul class="mt-4 flex flex-wrap gap-2" role="list" aria-label="Tags">
                  {post.data.tags.map((tag) => <li class="chip">{tag}</li>)}
                </ul>
              </div>
              <svg class="post-row__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
          </li>
        ))}
      </ol>
    )}

    <!-- Substack: Visage Quant -->
    <a href={NEWSLETTER_URL} target="_blank" rel="noopener noreferrer" class="newsletter-card reveal mt-24 sm:mt-32">
      <p class="eyebrow">Newsletter — Substack</p>
      <p class="mt-6 font-display text-[clamp(2rem,5vw,4.25rem)] font-semibold leading-[0.95] tracking-[-0.05em]">
        Read Visage Quant<span class="text-brand">.</span>
      </p>
      <p class="mt-6 max-w-xl text-base leading-relaxed text-ink/60">
        Song lyrics, film scripts and literature, read as data — text mining and visualisation in R.
      </p>
      <span class="mt-10 inline-flex items-center gap-2 text-sm font-medium text-brand">
        Open on Substack
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
      </span>
    </a>
  </section>
</BaseLayout>
