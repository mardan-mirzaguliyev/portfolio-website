---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<BaseLayout title="Page not found" noIndex={true}>
  <section class="px-6 pb-32 pt-36 sm:px-10 sm:pb-40 sm:pt-44 lg:px-16">
    <PageHeader eyebrow="404 — Not found" title="Lost the thread" lead="The page you're looking for doesn't exist or has moved." />
    <div class="reveal flex flex-wrap gap-4">
      <a href="/" class="cert-verify !mt-0">Go home</a>
      <a href="/projects" class="cert-verify cert-verify--ghost !mt-0">See projects</a>
    </div>
  </section>
</BaseLayout>
