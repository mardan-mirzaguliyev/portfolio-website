---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProjectCard from '../../components/ProjectCard.astro';

// Featured first, then alphabetical
const projects = (await getCollection('projects')).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.title.localeCompare(b.data.title),
);
---

<BaseLayout
  title="Projects"
  description="Data analysis, text mining, web development and teaching projects by Mardan Mirzaguliyev."
>
  <section class="px-6 pb-32 pt-36 sm:px-10 sm:pb-40 sm:pt-44 lg:px-16">
    <PageHeader
      eyebrow="Projects — Work"
      title="Selected work"
      lead={`${projects.length} projects across data analysis, text mining, web development and English teaching.`}
    />

    <ul class="grid gap-x-8 gap-y-20 md:grid-cols-2 lg:grid-cols-3" role="list">
      {projects.map((project, i) => (
        <li class="reveal" style={`--reveal-delay:${(i % 3) * 120}ms`}>
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            tags={project.data.tags}
            href={`/projects/${project.slug}`}
            liveUrl={project.data.liveUrl}
            repositoryUrl={project.data.repositoryUrl}
            documentUrl={project.data.document}
            featured={project.data.featured}
            logo={project.data.logo}
            index={i}
          />
        </li>
      ))}
    </ul>

  </section>
</BaseLayout>

