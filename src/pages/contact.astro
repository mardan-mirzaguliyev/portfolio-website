---
import BaseLayout from '../layouts/BaseLayout.astro';
import { socialLinks } from '../data/social';

const details = [
  { label: 'Based in',      value: 'Azerbaijan — working remotely worldwide' },
  { label: 'Open to',       value: 'Data analysis, text mining and web development work' },
  { label: 'Response time', value: 'Usually within 24 hours' },
];
---

<BaseLayout
  title="Contact"
  description="Get in touch with Mardan Mirzaguliyev — data analysis, text mining and web development."
>
  <section class="relative isolate overflow-hidden px-6 pb-32 pt-36 sm:px-10 sm:pb-40 sm:pt-44 lg:px-16">
    <p class="eyebrow reveal mb-8 flex items-center gap-4">
      <span class="h-px w-10 bg-ink/40" aria-hidden="true"></span>
      Contact — Say hello
    </p>
    <h1 class="reveal font-display text-[clamp(3rem,10.5vw,11rem)] font-semibold leading-[0.88] tracking-[-0.055em]">
      Let's make<br />
      <span class="text-ink/30">something</span> clear<span class="text-brand">.</span>
    </h1>

    <div class="mt-20 grid gap-20 border-t border-ink/10 pt-14 lg:mt-28 lg:grid-cols-12 lg:gap-10">

      <!-- ── Details + links ──────────────────────────────── -->
      <div class="lg:col-span-5">
        <p class="reveal max-w-sm text-lg leading-relaxed text-ink/60">
          A dataset with a story to tell, a role to discuss, or just saying hi — send a message and
          I'll get back to you.
        </p>

        <dl class="reveal mt-12 space-y-6" style="--reveal-delay:100ms">
          {details.map(({ label, value }) => (
            <div>
              <dt class="eyebrow">{label}</dt>
              <dd class="mt-2 text-base text-ink/80">{value}</dd>
            </div>
          ))}
        </dl>

        <ul class="reveal mt-14 border-t border-ink/10" role="list" aria-label="Elsewhere" style="--reveal-delay:200ms">
          {socialLinks.map(({ label, handle, href }) => (
            <li>
              <a href={href} target="_blank" rel="noopener noreferrer" class="link-row">
                <span class="link-row__label font-display">{label}</span>
                <span class="link-row__handle">{handle}</span>
                <svg class="link-row__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M7 17 17 7M8 7h9v9" />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- ── Message form (Netlify Forms) ─────────────────── -->
      <form
        name="contact"
        method="POST"
        data-netlify="true"
        data-netlify-honeypot="bot-field"
        action="/thanks"
        class="contact-form reveal lg:col-span-6 lg:col-start-7"
        style="--reveal-delay:120ms"
      >
        <input type="hidden" name="form-name" value="contact" />
        <div class="hidden" aria-hidden="true">
          <label>Don't fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </div>

        <div class="grid gap-12 sm:grid-cols-2 sm:gap-10">
          <div class="field">
            <input id="c-name" name="name" type="text" required autocomplete="name" placeholder=" " class="field__input" />
            <label for="c-name" class="field__label">Your name</label>
            <span class="field__line" aria-hidden="true"></span>
          </div>
          <div class="field">
            <input id="c-email" name="email" type="email" required autocomplete="email" placeholder=" " class="field__input" />
            <label for="c-email" class="field__label">Email address</label>
            <span class="field__line" aria-hidden="true"></span>
          </div>
        </div>

        <div class="field mt-12">
          <textarea id="c-message" name="message" required rows="4" placeholder=" " class="field__input field__input--area"></textarea>
          <label for="c-message" class="field__label">Your message</label>
          <span class="field__line" aria-hidden="true"></span>
        </div>

        <div class="mt-14 flex items-center justify-between gap-6">
          <p class="max-w-[15rem] text-xs leading-relaxed text-ink/40">
            No spam, ever. Your details are never shared with third parties.
          </p>
          <button type="submit" class="submit-btn" data-magnetic>
            <span class="submit-btn__label">
              Send
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </span>
          </button>
        </div>
      </form>
    </div>
  </section>
</BaseLayout>
