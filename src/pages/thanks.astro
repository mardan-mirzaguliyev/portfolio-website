---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<BaseLayout
  title="Message sent"
  description="Thank you for reaching out — I'll get back to you within 24 hours."
  noIndex={true}
>
  <section class="px-6 pb-32 pt-36 sm:px-10 sm:pb-40 sm:pt-44 lg:px-16">
    <PageHeader eyebrow="Contact — Sent" title="Message received" lead="Thanks for reaching out. I usually reply within 24 hours — keep an eye on your inbox." />
    <div class="reveal flex flex-wrap gap-4">
      <a href="/" class="cert-verify !mt-0">Back to home</a>
      <a href="/blog" class="cert-verify cert-verify--ghost !mt-0">Read the blog</a>
    </div>
  </section>
</BaseLayout>
