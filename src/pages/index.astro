---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingNav from '../components/landing/LandingNav.astro';
import Hero from '../components/landing/Hero.astro';
import Intro from '../components/landing/Intro.astro';
import About from '../components/landing/About.astro';
import FeaturedWork from '../components/landing/FeaturedWork.astro';
import Contact from '../components/landing/Contact.astro';
import '../styles/landing.css';

const featured = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.title.localeCompare(b.data.title))
  .slice(0, 3);
---

<BaseLayout title="Home" variant="landing">
  <LandingNav slot="header" />
  <Hero />
  <Intro />
  <About />
  <FeaturedWork projects={featured} />
  <Contact />
</BaseLayout>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const finePointer  = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const clamp = (v: number, min: number, max: number) => Math.min(max, Math.max(min, v));

  // ── Load sequence: release the hero entrance once fonts are in (or after 1.2s at worst)
  Promise.race([document.fonts.ready, new Promise((r) => setTimeout(r, 1200))]).then(() => {
    requestAnimationFrame(() => document.documentElement.classList.add('is-loaded'));
  });

  // ── Scroll reveals ─────────────────────────────────────────
  // Elements entering in the same frame cascade top-to-bottom, left-to-right
  const STAGGER_MS = 110;
  const io = new IntersectionObserver((entries) => {
    entries
      .filter((entry) => entry.isIntersecting)
      .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top || a.boundingClientRect.left - b.boundingClientRect.left)
      .forEach((entry, i) => {
        const el = entry.target as HTMLElement;
        el.style.setProperty('--stagger', `${i * STAGGER_MS}ms`);
        el.classList.add('is-visible');
        io.unobserve(el);
      });
  }, { rootMargin: '0px 0px -10% 0px' });
  document.querySelectorAll('.reveal, .reveal-clip').forEach((el) => io.observe(el));

  // ── Hero parallax + intro word highlight ───────────────────
  // Parallax eases toward the scroll position rather than snapping to it
  const hero        = document.querySelector<HTMLElement>('[data-hero]');
  const heroBg      = document.querySelector<HTMLElement>('[data-parallax-bg]');
  const heroContent = document.querySelector<HTMLElement>('[data-parallax-content]');
  const introText   = document.querySelector<HTMLElement>('[data-intro-words]');
  const introWords  = introText ? Array.from(introText.querySelectorAll<HTMLElement>('.intro-word')) : [];

  const LERP = 0.12;
  let smoothY = window.scrollY;
  let rafId = 0;

  function onFrame() {
    const targetY = window.scrollY;
    smoothY += (targetY - smoothY) * LERP;
    if (Math.abs(targetY - smoothY) < 0.1) smoothY = targetY;

    const y  = smoothY;
    const vh = window.innerHeight;

    if (y < vh * 1.2) {
      if (heroBg) heroBg.style.transform = `translate3d(0, ${y * 0.5}px, 0) scale(${1 + (y / vh) * 0.08})`;
      if (heroContent) {
        heroContent.style.transform = `translate3d(0, ${y * 0.22}px, 0)`;
        heroContent.style.opacity   = String(clamp(1 - y / (vh * 0.8), 0, 1));
      }
    }

    if (introText) {
      // 0 as the paragraph enters the lower viewport, 1 once its end passes the middle
      const rect     = introText.getBoundingClientRect();
      const start    = vh * 0.85;
      const end      = vh * 0.5;
      const progress = clamp((start - rect.top) / (rect.height + start - end), 0, 1);
      const lit      = progress * introWords.length;
      introWords.forEach((word, i) => {
        word.style.opacity = String(0.15 + 0.85 * clamp(lit - i, 0, 1));
      });
    }

    // Keep stepping until the eased value settles, then go idle
    rafId = smoothY !== targetY ? requestAnimationFrame(onFrame) : 0;
  }

  const requestFrame = () => { if (!rafId) rafId = requestAnimationFrame(onFrame); };

  if (!reduceMotion) {
    window.addEventListener('scroll', requestFrame, { passive: true });
    window.addEventListener('resize', requestFrame);
    onFrame();
  }

  // ── Pointer micro-interactions (mouse only) ────────────────
  if (finePointer && !reduceMotion) {
    // Gradient field drifts gently against the cursor
    hero?.addEventListener('pointermove', (e) => {
      const r = hero.getBoundingClientRect();
      hero.style.setProperty('--mx', String((e.clientX - r.left) / r.width - 0.5));
      hero.style.setProperty('--my', String((e.clientY - r.top) / r.height - 0.5));
    });

    // "View" bubble tracks the cursor inside each work card
    document.querySelectorAll<HTMLElement>('[data-cursor-area]').forEach((area) => {
      area.addEventListener('pointermove', (e) => {
        const r = area.getBoundingClientRect();
        area.style.setProperty('--cx', `${e.clientX - r.left - r.width / 2}px`);
        area.style.setProperty('--cy', `${e.clientY - r.top - r.height / 2}px`);
      });
    });

    // Magnetic buttons lean toward the cursor
    document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((el) => {
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        const dx = e.clientX - (r.left + r.width / 2);
        const dy = e.clientY - (r.top + r.height / 2);
        el.style.transform = `translate(${dx * 0.3}px, ${dy * 0.3}px)`;
      });
      el.addEventListener('pointerleave', () => { el.style.transform = ''; });
    });
  }
</script>
